<?xml version="1.0"?>

<materialx version="1.39" colorspace="lin_rec709">

    <standard_surface name="SimplePBR_Surface" type="surfaceshader">

        <input name="base" type="float" value="1.0" />

        <input
            name="base_color"
            type="color3"
            value="0.80, 0.08, 0.025"
        />

        <input
            name="metalness"
            type="float"
            value="0.75"
        />

        <input
            name="specular_roughness"
            type="float"
            value="0.25"
        />

        <input
            name="specular_IOR"
            type="float"
            value="1.5"
        />

    </standard_surface>

    <surfacematerial name="SimplePBR" type="material">

        <input
            name="surfaceshader"
            type="surfaceshader"
            nodename="SimplePBR_Surface"
        />

    </surfacematerial>

</materialx>